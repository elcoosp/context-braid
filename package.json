{
  "name": "context-braid",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "build": "pnpm -r build",
    "test:browser": "pnpm --filter @context-braid/extension test:browser",
    "test:unit": "pnpm --filter @context-braid/extension test:unit",
    "test:e2e": "pnpm --filter @context-braid/extension test:e2e",
    "store:validate": "extship --validate-only",
    "store:dry-run": "extship --dry-run",
    "store:sync": "extship",
    "store:sync:chrome": "pnpm --filter @context-braid/extension zip && extship --target chrome",
    "store:sync:edge": "pnpm --filter @context-braid/extension zip && extship --target edge",
    "store:sync:firefox": "pnpm --filter @context-braid/extension zip:firefox && extship --target firefox",
    "icons:sync": "./scripts/sync-icons.sh",
    "sync:locales": "node scripts/sync-locales.mjs && pnpm --filter context-braid-raycast i18n:check",
    "sync:version": "node scripts/sync-version.mjs",
    "check:sync": "node scripts/sync-locales.mjs && node scripts/sync-version.mjs --check && pnpm --filter context-braid-raycast i18n:check"
  },
  "devDependencies": {
    "@typescript/native-preview": "^7.0.0-dev",
    "oxlint": "^1.94.0",
    "oxfmt": "^0.80.0"
  },
  "packageManager": "pnpm@12.18.0"
}
